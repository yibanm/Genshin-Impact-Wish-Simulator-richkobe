{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "原神抽卡点名器桌面壳权限：仅开放数据导出所需的对话框与写文件能力",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "dialog:default",
    {
      "identifier": "fs:default",
      "allow": [
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$DOCUMENT/**"
        },
        {
          "path": "$DESKTOP/**"
        }
      ]
    },
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/**"
        }
      ]
    }
  ]
}
